# Copy this file to ".env" (same folder) and fill in YOUR values.
# NEVER share the .env file, upload it, or commit it. It is git-ignored.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
# Safety: live trading code does not exist in this build. These flags are
# read only to show status; changing them cannot enable live orders.
TRADING_MODE=PAPER
